{
  "manifest_version": 3,
  "name": "Component Picker",
  "version": "0.1.0",
  "description": "Hover any component, click, and copy its HTML, resolved CSS, interaction states, themes and responsive diffs as an AI-ready bundle.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "debugger",
    "storage",
    "sidePanel",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Component Picker — dock + side panel (Alt+Shift+C)",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "picker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "incognito": "spanning"
}
