{
  "manifest_version": 3,
  "name": "Component Picker",
  "version": "0.1.0",
  "description": "Hover any component, click, and copy its HTML, resolved CSS, interaction states, themes and responsive diffs as an AI-ready bundle.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "debugger",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pick a component (Alt+Shift+C)",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    }
  }
}
